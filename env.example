# Store the rotated Power Automate trigger URL only in the backend environment.
# Never commit a real URL/signature or put it in config.js.
POWER_AUTOMATE_URL=https://YOUR-POWER-AUTOMATE-TRIGGER-URL
PORT=8787
# Comma-separated frontend origins. Use your exact GitHub Pages origin when deployed separately.
ALLOWED_ORIGINS=http://localhost:8787,https://YOUR-USERNAME.github.io
